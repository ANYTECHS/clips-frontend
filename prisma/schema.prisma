// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Connection pooling configuration
  // These values are parsed from DATABASE_URL connection string parameters
  // Example: postgresql://user:pass@host:5432/db?connection_limit=10&pool_timeout=10
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  avatarUrl     String?
  plan          String         @default("free")
  planUsagePercent Int         @default(0)
  onboardingStep Int           @default(0)
  onboardingData Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]

  /**
   * Opt-in to the monthly earnings report email (Issue #820).
   *
   * Defaults to false: this mail carries a full transaction export, so it is
   * opt-in rather than opt-out — a creator has to ask for their financial
   * records to be posted to their inbox every month.
   */
  monthlyEarningsReport   Boolean   @default(false)
  /** Last successful send, used to skip a month the cron re-runs. */
  earningsReportSentAt    DateTime?
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    // job_complete | transform_complete | mint_success | earnings_received
  title     String?
  message   String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Delivery log for scheduled earnings reports (Issue #820).
 *
 * Doubles as the idempotency record. Vercel Cron delivers at least once, and a
 * retry after a partial failure must not email a creator their report twice —
 * the unique (userId, period) pair makes the second attempt a no-op.
 */
model EarningsReportDelivery {
  id        String   @id @default(cuid())
  userId    String
  /** Reported month as `YYYY-MM`. */
  period    String
  /** queued | sent | failed | skipped */
  status    String   @default("queued")
  recipient String
  rowCount  Int      @default(0)
  totalCents Int     @default(0)
  error     String?
  createdAt DateTime @default(now())
  sentAt    DateTime?

  @@unique([userId, period])
  @@index([period])
}
