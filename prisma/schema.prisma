// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Connection pooling configuration
  // These values are parsed from DATABASE_URL connection string parameters
  // Example: postgresql://user:pass@host:5432/db?connection_limit=10&pool_timeout=10
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  avatarUrl     String?
  plan          String         @default("free")
  planUsagePercent Int         @default(0)
  onboardingStep Int           @default(0)
  onboardingData Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
  apiKeys       ApiKey[]
  sessions      UserSession[]

  /**
   * Opt-in to the monthly earnings report email (Issue #820).
   *
   * Defaults to false: this mail carries a full transaction export, so it is
   * opt-in rather than opt-out — a creator has to ask for their financial
   * records to be posted to their inbox every month.
   */
  monthlyEarningsReport   Boolean   @default(false)
  /** Last successful send, used to skip a month the cron re-runs. */
  earningsReportSentAt    DateTime?
}

/// Outcome of a moderation check on one piece of content (Issue #1063).
///
/// Rows are never updated in place once a decision is final — a review or an
/// appeal appends a new decision referencing the previous one, so the full
/// history of how a piece of content was judged stays reconstructable.
model ModerationDecision {
  id           String    @id @default(cuid())
  /// Identifier of the content in the clips backend.
  contentId    String
  contentType  String    @default("clip") // clip | caption | thumbnail
  userId       String
  /// pending | approved | flagged | rejected
  status       String
  /// Which policy categories fired, and at what confidence.
  categories   Json?
  /// 0–1 confidence from the automated provider, null for human decisions.
  score        Float?
  /// automated | manual | appeal
  source       String    @default("automated")
  /// Provider that produced an automated decision, for auditability.
  provider     String?
  /// Reviewer's note, or the provider's reason string.
  reason       String?
  /// Set when a human made or overrode the call.
  reviewerId   String?
  /// Decision this one supersedes, forming the chain.
  supersedesId String?
  createdAt    DateTime  @default(now())

  appeals ModerationAppeal[]

  @@index([contentId])
  @@index([status, createdAt])
  @@index([userId])
}

/// A creator's challenge to a decision (Issue #1063).
model ModerationAppeal {
  id           String    @id @default(cuid())
  decisionId   String
  userId       String
  /// The creator's argument, in their own words.
  statement    String
  /// open | upheld | overturned
  status       String    @default("open")
  /// Reviewer's response, shown back to the creator.
  resolution   String?
  reviewerId   String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  decision ModerationDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    // job_complete | transform_complete | mint_success | earnings_received
  title     String?
  message   String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

/**
 * Delivery log for scheduled earnings reports (Issue #820).
 *
 * Doubles as the idempotency record. Vercel Cron delivers at least once, and a
 * retry after a partial failure must not email a creator their report twice —
 * the unique (userId, period) pair makes the second attempt a no-op.
 */
model EarningsReportDelivery {
  id        String   @id @default(cuid())
  userId    String
  /** Reported month as `YYYY-MM`. */
  period    String
  /** queued | sent | failed | skipped */
  status    String   @default("queued")
  recipient String
  rowCount  Int      @default(0)
  totalCents Int     @default(0)
  error     String?
  createdAt DateTime @default(now())
  sentAt    DateTime?

  @@unique([userId, period])
  @@index([period])
}

/// Secure API Key for authenticated API access (Issue #1164).
/// Raw key secrets are never stored in the database — only the SHA-256 hash
/// and an identification prefix are persisted.
model ApiKey {
  id          String     @id @default(cuid())
  userId      String
  name        String
  keyPrefix   String     // First 8 characters for identification (e.g. ck_live_a1b2)
  keyHash     String     @unique // SHA-256 hash of the complete key
  scopes      String[]   @default(["read", "write"])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  usages      ApiUsage[]

  @@index([userId])
  @@index([keyPrefix])
  @@index([keyHash])
}

/// Request metrics logged for API key usage (Issue #1164).
model ApiUsage {
  id           String   @id @default(cuid())
  apiKeyId     String
  endpoint     String
  method       String
  statusCode   Int
  responseTime Int
  createdAt    DateTime @default(now())

  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([createdAt])
}

/// Server-side tracked session supporting rotation, timeouts, and concurrent session limits (Issue #1163).
model UserSession {
  id             String    @id @default(cuid())
  userId         String
  sessionToken   String    @unique
  ipAddress      String?
  userAgent      String?
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([sessionToken])
}

/// Tamper-evident security audit trail with cryptographic hash chaining (Issue #1162).
/// Rows are append-only. Each record incorporates the previous record's hash to ensure
/// chronological integrity and detect any unauthorized modifications.
model AuditLog {
  id            String    @id @default(cuid())
  timestamp     DateTime  @default(now())
  actorId       String
  actorType     String    @default("user") // user | api_key | system | admin
  action        String    // e.g. auth.login, api_key.create, session.rotate
  resource      String    // e.g. api_key, session, user
  resourceId    String?
  requestId     String?
  ipAddress     String?
  userAgent     String?
  status        String    @default("success") // success | failure
  metadata      Json?
  schemaVersion Int       @default(1)
  previousHash  String?
  eventHash     String

  @@index([actorId, timestamp])
  @@index([action, timestamp])
  @@index([resource, resourceId])
  @@index([timestamp])
}

