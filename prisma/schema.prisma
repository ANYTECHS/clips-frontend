// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Connection pooling configuration
  // These values are parsed from DATABASE_URL connection string parameters
  // Example: postgresql://user:pass@host:5432/db?connection_limit=10&pool_timeout=10
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  avatarUrl     String?
  plan          String         @default("free")
  planUsagePercent Int         @default(0)
  onboardingStep Int           @default(0)
  onboardingData Json?
  preferences   Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  apiKeys       ApiKey[]
  sessions      UserSession[]
  webhookEndpoints WebhookEndpoint[]
  refreshTokens RefreshToken[]

  /**
   * Opt-in to the monthly earnings report email (Issue #820).
   *
   * Defaults to false: this mail carries a full transaction export, so it is
   * opt-in rather than opt-out — a creator has to ask for their financial
   * records to be posted to their inbox every month.
   */
  monthlyEarningsReport   Boolean   @default(false)
  notificationPreferences Json?
  /** Last successful send, used to skip a month the cron re-runs. */
  earningsReportSentAt    DateTime?
}

/// Outcome of a moderation check on one piece of content (Issue #1063).
///
/// Rows are never updated in place once a decision is final — a review or an
/// appeal appends a new decision referencing the previous one, so the full
/// history of how a piece of content was judged stays reconstructable.
model ModerationDecision {
  id           String    @id @default(cuid())
  /// Identifier of the content in the clips backend.
  contentId    String
  contentType  String    @default("clip") // clip | caption | thumbnail
  userId       String
  /// pending | approved | flagged | rejected
  status       String
  /// Which policy categories fired, and at what confidence.
  categories   Json?
  /// 0–1 confidence from the automated provider, null for human decisions.
  score        Float?
  /// automated | manual | appeal
  source       String    @default("automated")
  /// Provider that produced an automated decision, for auditability.
  provider     String?
  /// Reviewer's note, or the provider's reason string.
  reason       String?
  /// Set when a human made or overrode the call.
  reviewerId   String?
  /// Decision this one supersedes, forming the chain.
  supersedesId String?
  createdAt    DateTime  @default(now())

  appeals ModerationAppeal[]

  @@index([contentId])
  @@index([status, createdAt])
  @@index([userId])
}

/// A creator's challenge to a decision (Issue #1063).
model ModerationAppeal {
  id           String    @id @default(cuid())
  decisionId   String
  userId       String
  /// The creator's argument, in their own words.
  statement    String
  /// open | upheld | overturned
  status       String    @default("open")
  /// Reviewer's response, shown back to the creator.
  resolution   String?
  reviewerId   String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  decision ModerationDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    // job_complete | transform_complete | mint_success | earnings_received
  title     String?
  message   String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Delivery log for scheduled earnings reports (Issue #820).
 *
 * Doubles as the idempotency record. Vercel Cron delivers at least once, and a
 * retry after a partial failure must not email a creator their report twice —
 * the unique (userId, period) pair makes the second attempt a no-op.
 */
model EarningsReportDelivery {
  id        String   @id @default(cuid())
  userId    String
  /** Reported month as `YYYY-MM`. */
  period    String
  /** queued | sent | failed | skipped */
  status    String   @default("queued")
  recipient String
  rowCount  Int      @default(0)
  totalCents Int     @default(0)
  error     String?
  createdAt DateTime @default(now())
  sentAt    DateTime?

  @@unique([userId, period])
  @@index([period])
  @@index([status, createdAt])
}

/// Secure API Key for authenticated API access (Issue #1164).
/// Raw key secrets are never stored in the database — only the SHA-256 hash
/// and an identification prefix are persisted.
model ApiKey {
  id          String     @id @default(cuid())
  userId      String
  name        String
  keyPrefix   String     // First 8 characters for identification (e.g. ck_live_a1b2)
  keyHash     String     @unique // SHA-256 hash of the complete key
  scopes      String[]   @default(["read", "write"])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  usages      ApiUsage[]

  @@index([userId])
  @@index([keyPrefix])
  @@index([keyHash])
}

/// Request metrics logged for API key usage (Issue #1164).
model ApiUsage {
  id           String   @id @default(cuid())
  apiKeyId     String
  endpoint     String
  method       String
  statusCode   Int
  responseTime Int
  createdAt    DateTime @default(now())

  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([createdAt])
  // Per-key usage over a time window (#1174)
  @@index([apiKeyId, createdAt])
}

/// Server-side tracked session supporting rotation, timeouts, and concurrent session limits (Issue #1163).
/// Extended with geolocation and suspicious-login detection fields.
model UserSession {
  id             String    @id @default(cuid())
  userId         String
  sessionToken   String    @unique
  ipAddress      String?
  userAgent      String?
  /// ISO 3166-1 alpha-2 country code resolved from ipAddress at session creation (e.g. "US", "DE").
  country        String?
  /// Human-readable city name resolved from ipAddress, for display in alert emails.
  city           String?
  /// Approximate latitude used for impossible-travel distance calculation.
  latitude       Float?
  /// Approximate longitude used for impossible-travel distance calculation.
  longitude      Float?
  /// True when this session was flagged by the impossible-travel or new-country detector.
  suspicious     Boolean   @default(false)
  /// True when the user has completed the step-up authentication challenge for this session.
  stepUpVerified Boolean   @default(false)
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([sessionToken])
  @@index([userId, createdAt])
}

/// Tamper-evident security audit trail with cryptographic hash chaining (Issue #1162).
/// Rows are append-only. Each record incorporates the previous record's hash to ensure
/// chronological integrity and detect any unauthorized modifications.
model AuditLog {
  id            String    @id @default(cuid())
  timestamp     DateTime  @default(now())
  actorId       String
  actorType     String    @default("user") // user | api_key | system | admin
  action        String    // e.g. auth.login, api_key.create, session.rotate
  resource      String    // e.g. api_key, session, user
  resourceId    String?
  requestId     String?
  ipAddress     String?
  userAgent     String?
  status        String    @default("success") // success | failure
  metadata      Json?
  schemaVersion Int       @default(1)
  previousHash  String?
  eventHash     String

  @@index([actorId, timestamp])
  @@index([action, timestamp])
  @@index([resource, resourceId])
  @@index([timestamp])
}

/// Full-text search index for clips (Issue #1262).
/// This table maintains tsvector columns for efficient full-text search across clips.
model ClipSearchIndex {
  id         String   @id @default(cuid())
  clipId     String   @unique
  title      String
  style      String?
  tags       String?  // Stored as JSON array string
  searchText String   // Combined text for full-text search
  searchVector Unsupported("tsvector")?

  @@index([searchVector], type: Gin)
  @@index([clipId])
}

/// Full-text search index for projects/jobs (Issue #1262).
model ProjectSearchIndex {
  id         String   @id @default(cuid())
  jobId      String   @unique
  filename   String?
  status     String
  searchText String   // Combined text for full-text search
  searchVector Unsupported("tsvector")?

  @@index([searchVector], type: Gin)
  @@index([jobId])
}

/// Full-text search index for earnings transactions (Issue #1262).
model EarningSearchIndex {
  id          String   @id @default(cuid())
  transactionId String @unique
  description String
  platform    String?
  status      String
  searchText  String   // Combined text for full-text search
  searchVector Unsupported("tsvector")?

  @@index([searchVector], type: Gin)
  @@index([transactionId])
}

/// Outbound webhook subscription endpoint (Issue #1251).
model WebhookEndpoint {
  id          String            @id @default(cuid())
  userId      String
  url         String
  secret      String
  events      String[]
  active      Boolean           @default(true)
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([userId])
}

/// Outbound webhook delivery attempt and history (Issue #1251).
model WebhookDelivery {
  id            String          @id @default(cuid())
  endpointId    String
  eventType     String
  eventId       String
  payload       Json
  attempt       Int             @default(1)
  status        String          @default("pending") // pending | delivered | failed | dead_letter
  statusCode    Int?
  response      String?
  error         String?
  isDeadLetter  Boolean         @default(false)
  nextAttemptAt DateTime?
  attemptedAt   DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([isDeadLetter, createdAt])
}

/// Refresh token for JWT rotation with reuse detection.
///
/// Only the SHA-256 hash of the opaque token is stored — the plaintext token
/// is never persisted.  Each row belongs to a "family" (a chain of rotations
/// originating from a single initial authentication).  If a revoked token in
/// a family is presented, all tokens in that family are revoked immediately
/// (silent compromise detection).
model RefreshToken {
  id             String    @id @default(cuid())
  userId         String
  /// SHA-256 hex digest of the plaintext opaque token.  Never store plaintext.
  tokenHash      String    @unique
  /// Groups the full rotation chain so the entire family can be revoked on
  /// reuse detection.  Set to the first token's id and inherited by all
  /// successors in the chain.
  familyId       String
  /// Hash of the token that this row replaces, forming an auditable chain.
  replacedByHash String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
  @@index([expiresAt])
}

