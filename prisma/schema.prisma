// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Connection pooling configuration
  // These values are parsed from DATABASE_URL connection string parameters
  // Example: postgresql://user:pass@host:5432/db?connection_limit=10&pool_timeout=10
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  avatarUrl     String?
  plan          String         @default("free")
  planUsagePercent Int         @default(0)
  onboardingStep Int           @default(0)
  onboardingData Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
  webhooks      Webhook[]
  apiKeys       ApiKey[]
}

/// Outcome of a moderation check on one piece of content (Issue #1063).
///
/// Rows are never updated in place once a decision is final — a review or an
/// appeal appends a new decision referencing the previous one, so the full
/// history of how a piece of content was judged stays reconstructable.
model ModerationDecision {
  id           String    @id @default(cuid())
  /// Identifier of the content in the clips backend.
  contentId    String
  contentType  String    @default("clip") // clip | caption | thumbnail
  userId       String
  /// pending | approved | flagged | rejected
  status       String
  /// Which policy categories fired, and at what confidence.
  categories   Json?
  /// 0–1 confidence from the automated provider, null for human decisions.
  score        Float?
  /// automated | manual | appeal
  source       String    @default("automated")
  /// Provider that produced an automated decision, for auditability.
  provider     String?
  /// Reviewer's note, or the provider's reason string.
  reason       String?
  /// Set when a human made or overrode the call.
  reviewerId   String?
  /// Decision this one supersedes, forming the chain.
  supersedesId String?
  createdAt    DateTime  @default(now())

  appeals ModerationAppeal[]

  @@index([contentId])
  @@index([status, createdAt])
  @@index([userId])
}

/// A creator's challenge to a decision (Issue #1063).
model ModerationAppeal {
  id           String    @id @default(cuid())
  decisionId   String
  userId       String
  /// The creator's argument, in their own words.
  statement    String
  /// open | upheld | overturned
  status       String    @default("open")
  /// Reviewer's response, shown back to the creator.
  resolution   String?
  reviewerId   String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  decision ModerationDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    // job_complete | transform_complete | mint_success | earnings_received
  title     String?
  message   String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Webhook {
  id          String            @id @default(cuid())
  userId      String
  url         String
  events      String[]
  secret      String
  description String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  webhookId   String
  eventType   String
  payload     Json
  statusCode  Int?
  response    String?
  attempt     Int      @default(1)
  success     Boolean  @default(false)
  deliveredAt DateTime?
  nextRetryAt DateTime?
  createdAt   DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([deliveredAt])
}

model ApiKey {
  id          String   @id @default(cuid())
  userId      String
  name        String
  key         String   @unique
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  usages  ApiUsage[]

  @@index([userId])
  @@index([key])
}

model ApiUsage {
  id          String   @id @default(cuid())
  apiKeyId    String
  endpoint    String
  method      String
  statusCode  Int
  responseTime Int
  createdAt   DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([createdAt])
}
