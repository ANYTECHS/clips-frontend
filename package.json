    "pixelmatch": "^7.1.0",
    "playwright": "^1.60.0",
    "storybook": "^10.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
