# Copy this file to .env.local and fill in values for your environment.
#
# Legend:
#   [required]  — must be set for the app to work in the noted environment
#   [optional]  — has a safe default; only set to override
#   [secret]    — sensitive; never commit real values or expose to the client
#
# Variables prefixed with NEXT_PUBLIC_ are embedded in the client bundle and
# are therefore PUBLIC. Never put secrets in a NEXT_PUBLIC_ variable.

# ─── Authentication / OAuth ──────────────────────────────────────────────────
# [required] Google OAuth client credentials.
# Create at https://console.cloud.google.com/apis/credentials
# Example: 1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
# [required] [secret] Google OAuth client secret. Keep server-side only.
GOOGLE_CLIENT_SECRET=
# [required] Apple Sign In — your Apple developer account email/ID.
# Example: developer@example.com
APPLE_ID=
# [required] Apple developer Team ID (10 chars). Example: ABCDE12345
APPLE_TEAM_ID=
# [required] [secret] Apple Sign In private key (PEM). Replace newlines with \n.
APPLE_PRIVATE_KEY=
# [required] Apple Sign In key ID (10 chars). Example: ABCDE12345
APPLE_KEY_ID=

# ─── NextAuth ────────────────────────────────────────────────────────────────
# [required] [secret] Signs/encrypts session tokens. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
# [required] Public base URL of this app. Example: http://localhost:3000
NEXTAUTH_URL=

# ─── Sentry ──────────────────────────────────────────────────────────────────
# [optional] Sentry DSN for error monitoring. Public by design.
# Example: https://abc123@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=

# ─── API endpoints ───────────────────────────────────────────────────────────
# [required] Public base URL the frontend uses to reach the AI backend.
# Example: http://localhost:4000
NEXT_PUBLIC_API_URL=
# [required] Public base URL of the AI processing service.
# Example: http://localhost:5000
NEXT_PUBLIC_AI_API_URL=

# ─── AI backend secrets ──────────────────────────────────────────────────────
# [required] [secret] Bearer token sent to the AI backend. Server-side only.
AI_BACKEND_SECRET=
# [required] [secret] Secret the AI backend presents on callbacks.
# Generate with: openssl rand -hex 32
AI_BACKEND_CALLBACK_SECRET=

# ─── Cloud storage ───────────────────────────────────────────────────────────
# [required] Storage provider. Default: s3. Options: s3 | r2 | gcs
CLOUD_STORAGE_PROVIDER=s3
# [required] Bucket name. Example: clips-uploads
CLOUD_STORAGE_BUCKET=
# [required] Bucket region. Use "auto" for Cloudflare R2. Example: us-east-1
CLOUD_STORAGE_REGION=
# [required] [secret] Access key ID for the storage provider.
AWS_ACCESS_KEY_ID=
# [required] [secret] Secret access key for the storage provider.
AWS_SECRET_ACCESS_KEY=

# ─── Redis (job repository) ──────────────────────────────────────────────────
# [required] Redis connection URL (redis:// or rediss://).
# Example: redis://:password@hostname:6379
# For TLS: rediss://:password@hostname:6380
REDIS_URL=

# [optional] Redis connection pooling and retry configuration.
# Max retry attempts per command. Default: 3
REDIS_MAX_RETRIES=3
# Delay between retries in ms. Default: 1000
REDIS_RETRY_DELAY=1000
# Connection timeout in ms. Default: 10000
REDIS_CONNECT_TIMEOUT=10000
# Per-command timeout in ms. Default: 5000
REDIS_COMMAND_TIMEOUT=5000
# TCP keep-alive in ms. Default: 30000
REDIS_KEEP_ALIVE=30000
# Max reconnect attempts. Default: 10
REDIS_MAX_RECONNECT_ATTEMPTS=10
# Health check interval in ms. Default: 30000
REDIS_HEALTH_CHECK_INTERVAL=30000

# ─── Database (PostgreSQL with connection pooling) ───────────────────────────
# [required] [secret] PostgreSQL connection string.
# Pooling can be set via URL params or the vars below.
# Example: postgresql://user:pass@localhost:5432/clips?connection_limit=10&pool_timeout=10
DATABASE_URL=postgresql://user:password@localhost:5432/clips

# [optional] Connection pool configuration (overrides URL params).
# Max pool size. Default: 10
DATABASE_POOL_SIZE=10
# Connection timeout in ms. Default: 10000
DATABASE_CONNECTION_TIMEOUT=10000
# Idle timeout in ms. Default: 30000
DATABASE_POOL_IDLE_TIMEOUT=30000
# Log pool metrics. Default: false
DATABASE_LOG_POOL_METRICS=false
# Log queries slower than this in ms. Default: 1000
DATABASE_SLOW_QUERY_THRESHOLD=1000

# ─── Local dev settings ──────────────────────────────────────────────────────
# [optional] Set true in CI to disable interactive behavior. Default: false
CI=false
# [optional] Node environment. Default: development. Options: development | production | test
NODE_ENV=development
