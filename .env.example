# ClipCash frontend — environment template
#
#   cp .env.example .env.local      # .env.local is git-ignored
#
# Full reference (descriptions, defaults, security notes): docs/ENVIRONMENT_VARIABLES.md
#
# Legend:
#   [REQUIRED]       checked at startup in every environment (app/lib/validateEnv.ts)
#   [REQUIRED:PROD]  checked at startup when NODE_ENV=production or CI=true
#   [CONDITIONAL]    required only when the related feature is used
#   [OPTIONAL]       has a default (shown) or degrades gracefully
#
# NEXT_PUBLIC_* values are inlined into the browser bundle. NEVER put secrets in them.

# ─── Authentication (NextAuth) ───────────────────────────────────────────────
# [REQUIRED] Secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# [REQUIRED] Canonical app origin
NEXTAUTH_URL=http://localhost:3000

# [REQUIRED] Google OAuth — secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [REQUIRED] Apple Sign In — secret
APPLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Full PEM key; replace newlines with \n if on one line
APPLE_PRIVATE_KEY=

# [CONDITIONAL] Social account linking — secrets
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# [OPTIONAL] Passkey relying-party ID (default: request hostname).
# Changing it invalidates existing passkeys.
WEBAUTHN_RP_ID=

# ─── Core services & URLs ────────────────────────────────────────────────────
# [REQUIRED:PROD] Main backend API (must be http:// or https://)
NEXT_PUBLIC_API_URL=http://localhost:4000
# [OPTIONAL] Public origin for share/referral links (default: http://localhost:3000)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# [OPTIONAL] "staging" switches CSP to Report-Only. Never use in production.
NEXT_PUBLIC_ENVIRONMENT=
# [OPTIONAL] Default API route timeout in ms (default: 10000)
API_TIMEOUT_MS=10000
# [OPTIONAL] API response compression (defaults: true / 1024 bytes)
COMPRESSION_ENABLED=true
COMPRESSION_MIN_BYTES=1024

# ─── AI Processing Backend ───────────────────────────────────────────────────
# [REQUIRED:PROD] Upload route POSTs jobs to <NEXT_PUBLIC_AI_API_URL>/jobs
NEXT_PUBLIC_AI_API_URL=http://localhost:5000
# [CONDITIONAL] Secret. Bearer token on outbound AI backend requests
AI_BACKEND_SECRET=
# [REQUIRED:PROD] Secret. AI backend must send this to /api/jobs/[id]/callback.
# Generate with: openssl rand -hex 32
AI_BACKEND_CALLBACK_SECRET=

# ─── Cloud Storage ───────────────────────────────────────────────────────────
# [REQUIRED:PROD] "s3" (default) | "r2" | "gcs"
CLOUD_STORAGE_PROVIDER=s3
# [REQUIRED:PROD]
CLOUD_STORAGE_BUCKET=clips-uploads
# [REQUIRED:PROD] Use "auto" for Cloudflare R2 (default: us-east-1)
CLOUD_STORAGE_REGION=us-east-1
# [CONDITIONAL] Required for R2 / GCS; leave blank for AWS S3.
#   R2:  https://<account-id>.r2.cloudflarestorage.com
#   GCS: https://storage.googleapis.com
CLOUD_STORAGE_ENDPOINT=
# [OPTIONAL] Object key prefixes
CLOUD_STORAGE_KEY_PREFIX=uploads/
CLOUD_STORAGE_CHUNK_PREFIX=uploads/chunks/
# [REQUIRED:PROD] Secrets. Scope to this bucket only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Virus Scanning ──────────────────────────────────────────────────────────
# [OPTIONAL] Default: true in production, false otherwise
VIRUS_SCAN_ENABLED=false
# [OPTIONAL] "clamav" (default) | "virustotal" | "cloudmersive" | "disabled"
VIRUS_SCAN_PROVIDER=clamav
# [OPTIONAL] ms (default: 30000)
VIRUS_SCAN_TIMEOUT=30000
# [OPTIONAL] (default: uploads/quarantine/)
VIRUS_SCAN_QUARANTINE_PREFIX=uploads/quarantine/
# [OPTIONAL] "true" lets files through if the scanner errors. Unsafe in production.
VIRUS_SCAN_ALLOW_ON_FAILURE=false
# [CONDITIONAL] provider=clamav
CLAMAV_API_URL=http://localhost:8080
# [CONDITIONAL] provider=virustotal — secret
VIRUSTOTAL_API_KEY=
# [OPTIONAL] ms (default: 5000)
VIRUSTOTAL_POLL_INTERVAL_MS=5000
# [CONDITIONAL] provider=cloudmersive — secret
CLOUDMERSIVE_API_KEY=

# ─── Redis ───────────────────────────────────────────────────────────────────
# [REQUIRED:PROD] Secret (contains password). redis:// or rediss:// (TLS).
# Leave blank locally to use the in-memory job store.
#   redis://:password@hostname:6379
#   rediss://:password@hostname:6380
REDIS_URL=
# [OPTIONAL] Connection tuning (values shown are defaults)
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_KEEP_ALIVE=30000
REDIS_MAX_RECONNECT_ATTEMPTS=10
REDIS_HEALTH_CHECK_INTERVAL=30000

# ─── Database (PostgreSQL / Prisma) ──────────────────────────────────────────
# [CONDITIONAL] Secret (contains password). Pool params may go in the URL:
#   postgresql://user:pass@localhost:5432/clips?connection_limit=10&pool_timeout=10
DATABASE_URL=postgresql://user:password@localhost:5432/clips
# [OPTIONAL] Pool tuning (values shown are defaults)
DATABASE_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT=10000
DATABASE_POOL_IDLE_TIMEOUT=30000
DATABASE_LOG_POOL_METRICS=false
DATABASE_SLOW_QUERY_THRESHOLD=1000

# ─── Operations: cron, metrics, logging ──────────────────────────────────────
# [CONDITIONAL] Secret. Bearer token for /api/cron/*. Production rejects all cron calls without it.
CRON_SECRET=
# [OPTIONAL] Cron tuning (values shown are defaults)
STALLED_JOB_THRESHOLD_MS=600000
REQUEUE_MAX_JOBS=20
CLEANUP_JOB_AGE_MS=604800000
CLEANUP_MAX_JOBS=500
# [CONDITIONAL] Secret. Bearer token for /api/metrics. Production denies all requests without it.
METRICS_TOKEN=
# [OPTIONAL] HTTP endpoint that receives structured logs
LOG_DRAIN_URL=

# ─── Monitoring (Sentry) ─────────────────────────────────────────────────────
# [REQUIRED] DSN is public by design (send-only)
NEXT_PUBLIC_SENTRY_DSN=
# [OPTIONAL] Defaults: NODE_ENV / VERCEL_GIT_COMMIT_SHA or "development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=

# ─── Stellar / Wallet ────────────────────────────────────────────────────────
# [OPTIONAL] "testnet" (default) | "mainnet" — mainnet spends real funds
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# [OPTIONAL] Soroban RPC override
NEXT_PUBLIC_STELLAR_RPC=https://soroban-testnet.stellar.org
# [CONDITIONAL] NFT contract IDs (required for minting)
NEXT_PUBLIC_STELLAR_NFT_CONTRACT_ID=
NEXT_PUBLIC_STELLAR_NFT_CONTRACT_ID_MAINNET=
# [OPTIONAL] PUBLIC key of the fee-sponsor account. Never put the secret key here.
NEXT_PUBLIC_SPONSOR_PUBLIC_KEY=
# [OPTIONAL] XLM/USD fallback price (default: 0.12)
NEXT_PUBLIC_XLM_FALLBACK_PRICE_USD=0.12

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
# [CONDITIONAL] Secret. Without it, checkout returns a simulated success.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ─── Social Recovery Email ───────────────────────────────────────────────────
# [OPTIONAL] (default: noreply@clipcash.ai)
EMAIL_FROM=noreply@clipcash.ai
# [CONDITIONAL] Secret. Used once the Resend block in app/api/recovery/shared/mailer.ts is enabled
RESEND_API_KEY=

# ─── Analytics ───────────────────────────────────────────────────────────────
# [OPTIONAL] "ga4" | "plausible" | "custom" | "none" (default)
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
# [CONDITIONAL] provider=ga4
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA4_SCRIPT_SRI_HASH=
# [CONDITIONAL] provider=plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRI_HASH=
# [CONDITIONAL] provider=custom
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# ─── AI Video Transformation ─────────────────────────────────────────────────
# [OPTIONAL] Allowed styles (default: anime,cinematic,sketch,watercolor,retro-vhs,neon-noir)
NEXT_PUBLIC_TRANSFORM_STYLES=anime,cinematic,sketch,watercolor,retro-vhs,neon-noir

# ─── CDN ─────────────────────────────────────────────────────────────────────
# [OPTIONAL] Asset CDN base; blank = app origin
NEXT_PUBLIC_CDN_URL=
# [OPTIONAL] Default: <NEXT_PUBLIC_CDN_URL>/api/purge
CDN_PURGE_API_URL=
# [OPTIONAL] Secret. Purge is a no-op without it.
CDN_PURGE_SECRET=

# ─── Client data layer (values shown are defaults) ───────────────────────────
NEXT_PUBLIC_DATA_CACHE_TTL_MS=60000
NEXT_PUBLIC_DATA_STALE_TTL_MS=300000
NEXT_PUBLIC_DATA_DEDUPE_WINDOW_MS=0
NEXT_PUBLIC_DATA_SYNC_MAX_RETRIES=3
NEXT_PUBLIC_DATA_SYNC_INITIAL_DELAY_MS=1000
NEXT_PUBLIC_DATA_SYNC_BACKOFF_MULTIPLIER=2
NEXT_PUBLIC_DATA_SYNC_MAX_DELAY_MS=10000
NEXT_PUBLIC_DATA_PERSIST_CACHE=true
NEXT_PUBLIC_DATA_PERSIST_QUEUE=true

# ─── Build / test tooling ────────────────────────────────────────────────────
# CI=true makes env validation strict. NODE_ENV is normally set by Next.js.
CI=false
# ANALYZE=true opens the bundle analyzer (npm run analyze)
ANALYZE=
# E2E only: "true" bypasses auth middleware. NEVER set in a deployed environment.
E2E_SKIP_MIDDLEWARE=
