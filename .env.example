# Copy this file to .env.local and fill in values for your environment.
#
# Every environment variable the app reads is listed here. Full reference, with
# defaults and which environments need each value: docs/ENVIRONMENT_VARIABLES.md
# `npm run env:check` fails if code reads a variable that isn't listed here.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time —
# never put a secret in one. Commented-out lines are optional overrides; the
# value shown is the default the app uses when the line is absent.

# ─── Auth (required in all environments) ────────────────────────────────────
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# Google OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple Sign In credentials
APPLE_ID=your_apple_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
# Paste the full PEM private key (replace newlines with \n if needed)
APPLE_PRIVATE_KEY=your_apple_private_key

# Social platform OAuth (optional — each provider is only usable when set)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Passkeys: WebAuthn relying-party ID. Defaults to the request hostname.
# WEBAUTHN_RP_ID=clipcash.ai

# ─── App origin ──────────────────────────────────────────────────────────────
# Public origin used for canonical/OG metadata, sitemap, robots, and share and
# referral links. Defaults to https://clipcash.ai in production and
# http://localhost:3000 otherwise. NEXT_PUBLIC_BASE_URL is the legacy name and
# is still read when NEXT_PUBLIC_SITE_URL is unset.
# NEXT_PUBLIC_SITE_URL=https://clipcash.ai

# Deployment label. "staging" sends the CSP as Content-Security-Policy-Report-Only
# so violations are reported without breaking the page.
# NEXT_PUBLIC_ENVIRONMENT=development

# ─── Sentry (required in all environments) ───────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
# Defaults to NODE_ENV
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Defaults to VERCEL_GIT_COMMIT_SHA, then "development"
# NEXT_PUBLIC_SENTRY_RELEASE=
# Set automatically by Vercel
# VERCEL_GIT_COMMIT_SHA=

# ─── API (required in production) ────────────────────────────────────────────
# Backend API URL for the main application
NEXT_PUBLIC_API_URL=http://localhost:4000

# Per-request timeout for API route handlers in ms (default 10000)
# API_TIMEOUT_MS=10000

# Response compression for API routes
# COMPRESSION_ENABLED=true
# COMPRESSION_MIN_BYTES=1024

# Bearer token required by /api/metrics. Unset: requests are denied in
# production and accepted (with a warning) elsewhere.
METRICS_TOKEN=

# ─── AI Processing Backend (required in production) ──────────────────────────
# Base URL of the AI video processing service.
# The upload route POSTs job payloads to <NEXT_PUBLIC_AI_API_URL>/jobs.
NEXT_PUBLIC_AI_API_URL=http://localhost:5000

# Shared secret sent as a Bearer token on outbound AI backend requests.
AI_BACKEND_SECRET=your_ai_backend_secret

# Secret the AI backend must include when calling /api/jobs/[id]/callback.
# Generate with: openssl rand -hex 32
AI_BACKEND_CALLBACK_SECRET=your_callback_secret

# AI video transformation styles (comma-separated), validated in /api/transform.
NEXT_PUBLIC_TRANSFORM_STYLES=anime,cinematic,sketch,watercolor

# ─── Cloud Storage (required in production) ──────────────────────────────────
# Provider: "s3" (default) | "r2" | "gcs"
CLOUD_STORAGE_PROVIDER=s3

# Bucket name (create this in your cloud console first)
CLOUD_STORAGE_BUCKET=clips-uploads

# Region (use "auto" for Cloudflare R2)
CLOUD_STORAGE_REGION=us-east-1

# Custom endpoint — required for Cloudflare R2 and GCS S3 interop.
# Leave blank for standard AWS S3.
# R2 example: https://<account-id>.r2.cloudflarestorage.com
# GCS example: https://storage.googleapis.com
CLOUD_STORAGE_ENDPOINT=

# Object key prefixes
CLOUD_STORAGE_KEY_PREFIX=uploads/
# CLOUD_STORAGE_CHUNK_PREFIX=uploads/chunks/

# AWS / R2 / GCS S3-interop credentials
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# Per-file upload limit in MB, enforced by the upload page and the upload API.
# NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=500

# ─── Virus Scanning ───────────────────────────────────────────────────────────
# Files are stored under the quarantine prefix before scanning and moved only
# if clean. Enabled by default in production, disabled in development.

# Scan provider: "clamav" | "virustotal" | "cloudmersive" | "disabled"
VIRUS_SCAN_PROVIDER=clamav
VIRUS_SCAN_ENABLED=true
# Timeout for a scan in ms (default 30000)
VIRUS_SCAN_TIMEOUT=30000
VIRUS_SCAN_QUARANTINE_PREFIX=uploads/quarantine/
# Accept the upload when the scanner itself fails. Leave false in production.
# VIRUS_SCAN_ALLOW_ON_FAILURE=false

# ClamAV (required if VIRUS_SCAN_PROVIDER=clamav)
CLAMAV_API_URL=http://localhost:8080

# VirusTotal (required if VIRUS_SCAN_PROVIDER=virustotal)
# Get your API key from https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key
# Delay between analysis polls in ms (default 5000)
# VIRUSTOTAL_POLL_INTERVAL_MS=5000

# Cloudmersive (required if VIRUS_SCAN_PROVIDER=cloudmersive)
CLOUDMERSIVE_API_KEY=your_cloudmersive_api_key

# ─── Content moderation (optional) ────────────────────────────────────────────
# Provider label reported in moderation results (default "unconfigured").
# Without both MODERATION_API_URL and MODERATION_API_KEY, content is queued
# for manual review.
MODERATION_PROVIDER=
MODERATION_API_URL=
MODERATION_API_KEY=

# ─── Redis (required in production) ───────────────────────────────────────────
# Used by the job repository (redis:// or rediss://)
# Example: redis://:password@hostname:6379
# For TLS: rediss://:password@hostname:6380
REDIS_URL=

# Connection pooling and retry (optional)
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_KEEP_ALIVE=30000
REDIS_MAX_RECONNECT_ATTEMPTS=10
REDIS_HEALTH_CHECK_INTERVAL=30000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Connection pooling can be set with URL parameters, e.g.
# postgresql://user:pass@localhost:5432/clips?connection_limit=10&pool_timeout=10
DATABASE_URL=postgresql://user:password@localhost:5432/clips

# Pool configuration (optional — overrides URL parameters)
DATABASE_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT=10000
DATABASE_POOL_IDLE_TIMEOUT=30000
DATABASE_LOG_POOL_METRICS=false
DATABASE_SLOW_QUERY_THRESHOLD=1000

# ─── Background jobs / cron ───────────────────────────────────────────────────
# Bearer token Vercel Cron presents to /api/cron/* routes.
# Required in production — without it those routes refuse every request.
CRON_SECRET=

# /api/cron/cleanup-old-jobs: delete finished jobs older than this (default 7 days)
# CLEANUP_JOB_AGE_MS=604800000
# CLEANUP_MAX_JOBS=500

# /api/cron/requeue-stalled-jobs: requeue jobs stuck longer than this (default 10 min)
# STALLED_JOB_THRESHOLD_MS=600000
# REQUEUE_MAX_JOBS=20

# ─── Stellar ──────────────────────────────────────────────────────────────────
# Network: "testnet" (default) or "mainnet"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional Soroban RPC URL override (applies to both networks)
NEXT_PUBLIC_STELLAR_RPC=https://soroban-testnet.stellar.org

# Optional Horizon URL overrides, e.g. a private Horizon node
# NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# NEXT_PUBLIC_STELLAR_HORIZON_URL_MAINNET=https://horizon.stellar.org

# NFT contract addresses
NEXT_PUBLIC_STELLAR_NFT_CONTRACT_ID=
NEXT_PUBLIC_STELLAR_NFT_CONTRACT_ID_MAINNET=

# Public key of the fee-sponsorship account. Unset = sponsorship is off.
NEXT_PUBLIC_SPONSOR_PUBLIC_KEY=

# ─── Prices ───────────────────────────────────────────────────────────────────
# CoinGecko-compatible price API (server-side only)
# PRICE_API_URL=https://api.coingecko.com/api/v3

# XLM/USD price shown when the price API is unreachable
# NEXT_PUBLIC_XLM_FALLBACK_PRICE_USD=0.12

# ─── Billing (optional) ───────────────────────────────────────────────────────
# Without STRIPE_SECRET_KEY, /api/billing/checkout returns a simulated checkout.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ─── Email ────────────────────────────────────────────────────────────────────
# From address used for guardian approval and report emails
EMAIL_FROM=noreply@clipcash.ai

# Resend API key (https://resend.com) — used by app/api/recovery/shared/mailer.ts
RESEND_API_KEY=re_your_resend_api_key

# ─── Analytics (optional) ─────────────────────────────────────────────────────
# Provider: "ga4" | "plausible" | "custom" | "none" (default)
NEXT_PUBLIC_ANALYTICS_PROVIDER=none

# Google Analytics 4 Measurement ID (if using ga4)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Subresource-integrity hash for the GA4 script (see scripts/verify-script-sri.js)
# NEXT_PUBLIC_GA4_SCRIPT_SRI_HASH=

# Plausible (if using plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=clipcash.ai
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRI_HASH=

# Custom analytics endpoint (if using custom)
NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://your-analytics-api.com/events

# ─── Logging (optional) ───────────────────────────────────────────────────────
# HTTP endpoint that receives info/warn/error log entries as JSON
LOG_DRAIN_URL=

# ─── CDN (optional) ───────────────────────────────────────────────────────────
# Base URL of the CDN that serves /_next/static/ and /public assets.
# Leave blank in development — the app origin is used instead.
# Example: https://cdn.clipcash.dev
NEXT_PUBLIC_CDN_URL=

# Purge API endpoint called when on-demand invalidation is needed.
# Defaults to <NEXT_PUBLIC_CDN_URL>/api/purge if not set.
CDN_PURGE_API_URL=

# Bearer token sent to the purge endpoint. Keep server-side only.
CDN_PURGE_SECRET=

# ─── Data layer (optional) ───────────────────────────────────────────────────
# GET cache freshness window in ms (default 60000)
NEXT_PUBLIC_DATA_CACHE_TTL_MS=60000

# Extra time cached data may be served stale or offline in ms (default 300000)
NEXT_PUBLIC_DATA_STALE_TTL_MS=300000

# After an in-flight GET settles, reuse it for this window in ms (default 0)
NEXT_PUBLIC_DATA_DEDUPE_WINDOW_MS=0

# Offline mutation replay
NEXT_PUBLIC_DATA_SYNC_MAX_RETRIES=3
NEXT_PUBLIC_DATA_SYNC_INITIAL_DELAY_MS=1000
NEXT_PUBLIC_DATA_SYNC_BACKOFF_MULTIPLIER=2
NEXT_PUBLIC_DATA_SYNC_MAX_DELAY_MS=10000

# Persist GET cache / mutation queue to localStorage (default true)
NEXT_PUBLIC_DATA_PERSIST_CACHE=true
NEXT_PUBLIC_DATA_PERSIST_QUEUE=true

# ─── Build & tooling ──────────────────────────────────────────────────────────
NODE_ENV=development
# Set by CI providers; "true" enforces production env validation
CI=false
# "true" opens the bundle analyzer on `next build` (npm run analyze sets it)
# ANALYZE=false
# "true" bypasses route-protection middleware. Playwright only — never in production.
# E2E_SKIP_MIDDLEWARE=false

# Deprecated: use NEXT_PUBLIC_SITE_URL
# NEXT_PUBLIC_BASE_URL=
