{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "proxy.ts",
    "scripts/*.mjs",
    "lib/**/*.test.ts",
    "components/**/*.test.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "tests/**/*.ts",
    "scripts/**/*.mjs",
    "proxy.ts"
  ],
  "ignore": ["clips-backend/**", "performance/**"],
  "ignoreBinaries": ["prisma"]
}
